[Unit]
Description=Acortador de enlaces (FastAPI)
After=network.target

[Service]
User=ec2-user
WorkingDirectory=/home/ec2-user/acortador-enlaces/backend
EnvironmentFile=/home/ec2-user/acortador-enlaces/backend/.env
ExecStart=/home/ec2-user/acortador-enlaces/backend/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000
Restart=always

[Install]
WantedBy=multi-user.target
